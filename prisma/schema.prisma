generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id
  email    String   @unique
  name     String
  imageUrl String?

  memberships    GroupMember[]
  expensesPaid   Expense[]     @relation("PaidExpenses")
  splits         ExpenseSplit[]
  settlementsFrom Settlement[] @relation("SettlementFrom")
  settlementsTo   Settlement[] @relation("SettlementTo")
}

model Group {
  id          String         @id @default(cuid())
  name        String
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

model GroupMember {
  groupId String
  userId  String
  role    String

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([groupId, userId])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String
  paidById    String
  amountCents Int
  description String
  createdAt   DateTime       @default(now())

  // Multi-currency (phase 07): the amount is entered in `currency` and
  // converted once to USD at save time. `amountCents` is ALWAYS USD (the
  // ledger currency); `nativeAmountCents` preserves what the user actually
  // entered so rows can display the original amount.
  currency          String   @default("USD")
  nativeAmountCents Int      @default(0)

  group  Group         @relation(fields: [groupId], references: [id])
  payer  User          @relation("PaidExpenses", fields: [paidById], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  expenseId   String
  userId      String
  amountCents Int

  expense Expense @relation(fields: [expenseId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
}

model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String
  toUserId    String
  amountCents Int
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  from  User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to    User  @relation("SettlementTo", fields: [toUserId], references: [id])
}